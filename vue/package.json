{
    "name": "customerbot-vue",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite --host 0.0.0.0",
        "build": "vue-tsc --noEmit && vite build",
        "preview": "vite preview",
        "typecheck": "vue-tsc --noEmit",
        "test": "npm run test:unit",
        "test:unit": "node --experimental-strip-types --test \"tests/unit/**/*.test.mjs\"",
        "test:smoke": "node tests/smoke.mjs",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "dependencies": {
        "@fortawesome/fontawesome-free": "^6.7.2",
        "@microsoft/signalr": "^8.0.29",
        "@vueuse/core": "^15.0.0",
        "admin-lte": "^4.10.0",
        "axios": "^1.21.1",
        "dayjs": "^1.11.23",
        "echarts": "^6.1.0",
        "element-plus": "^2.9.0",
        "pinia": "^4.1.0",
        "vue": "^3.5.0",
        "vue-router": "^4.5.0",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@vitejs/plugin-vue": "^5.2.0",
        "playwright-core": "^1.65.0",
        "prettier": "^3.9.10",
        "typescript": "^6.0.3",
        "vite": "^6.0.0",
        "vue-tsc": "^3.3.14"
    }
}
